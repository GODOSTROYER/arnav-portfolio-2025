{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "arnav-portfolio-2025.vercel.app" }],
      "destination": "https://www.arnavbule.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arnav-portfolio-2025.vercel.app" }],
      "destination": "https://www.arnavbule.in/:path*",
      "permanent": true
    },
    {
      "source": "/task-tracker",
      "destination": "https://task-tracker-godostroyers-projects.vercel.app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/tree-qr-studio",
      "destination": "/tree-qr-studio/index.html"
    },
    {
      "source": "/tree-qr-studio/",
      "destination": "/tree-qr-studio/index.html"
    }
  ]
}
