{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "arnav-portfolio-2025.vercel.app"
        }
      ],
      "destination": "https://www.arnavbule.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arnav-portfolio-2025.vercel.app"
        }
      ],
      "destination": "https://www.arnavbule.in/:path*",
      "permanent": true
    },
    {
      "source": "/task-tracker",
      "destination": "https://task-tracker-godostroyers-projects.vercel.app",
      "permanent": false
    },
    {
      "source": "/ai-exam-checker",
      "destination": "https://www.arnavbule.in/parakh",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hiver-assignment",
      "destination": "https://cadence-hiver.vercel.app/hiver-assignment/"
    },
    {
      "source": "/hiver-assignment/:path*",
      "destination": "https://cadence-hiver.vercel.app/hiver-assignment/:path*"
    },
    {
      "source": "/parakh",
      "destination": "https://parakh-eta.vercel.app/parakh"
    },
    {
      "source": "/parakh/:path*",
      "destination": "https://parakh-eta.vercel.app/parakh/:path*"
    }
  ]
}
